<PageTitle>@State.Flow.Name() · Verify Wizard</PageTitle>

@* Nothing renders until the url has been read and the browser's memory applied, so a restored
   answer never flashes in after the page has drawn without it. *@
@if (ready)
{
    <div class="wizard-layout">
        <Breadcrumb State="State" Steps="Steps" Today="today" StepSelected="GoTo" />

        <section class="step-body" data-step="@State.Step">
            <div class="step-heading">
                <h2>@Current.Title</h2>
                @* The optional steps have long lists, so Skip sits at the top where it needs no scroll. *@
                @if (State.Step is "have" or "tech" or "plugins" &&
                     NextStep is { } skipTo)
                {
                    <button type="button" class="skip" @onclick="() => Skip(skipTo.Id)">Skip</button>
                }
            </div>

            @switch (State.Step)
            {
                case "os":
                    <p class="hint">Every OS the team develops on, not the ones the tests or app deploy to. Decides which diff tools are listed, and whether DiffEngineTray is suggested.</p>
                    <ToggleCards TValue="Os" Options="osChoices" Values="State.OperatingSystems" Toggled="_ => Set(wizard => wizard.SetOperatingSystem(_.Value, _.Selected))" IdPrefix="os" Label="Developer operating systems" />
                    break;
                case "ide":
                    <p class="hint">Rider and ReSharper have a Verify plugin for accepting snapshots in the test runner.</p>
                    <ChoiceCards TValue="Ide" Options="IdeChoices" Value="State.Ide" ValueChanged="_ => SetAndAdvance(State.Ide == null, wizard => wizard.Ide = _)" IdPrefix="ide" Label="IDE" />
                    break;
                case "cli":
                    <p class="hint">This will affect the approach to installing NuGet packages and snapshot management options.</p>
                    <ChoiceCards TValue="CliPreference" Options="cliChoices" Value="State.Cli" ValueChanged="_ => SetAndAdvance(State.Cli == null, wizard => wizard.Cli = _)" IdPrefix="cli" Label="CLI or GUI" />
                    break;
                case "tf":
                    @if (State.Flow != Flow.New)
                    {
                        <p class="hint">The test framework the project already uses. It decides the attributes on the generated tests.</p>
                    }
                    <ChoiceCards TValue="TestFramework" Options="testFrameworkChoices" Value="State.TestFramework" ValueChanged="_ => SetAndAdvance(State.TestFramework == null, wizard => wizard.TestFramework = _)" IdPrefix="tf" Label="Test framework" />
                    break;
                case "ci":
                    <p class="hint">Generates a build definition that runs the tests and publishes any <code>*.received.*</code> files when they fail.</p>
                    <ChoiceCards TValue="BuildServer" Options="buildServerChoices" Value="State.BuildServer" ValueChanged="_ => SetAndAdvance(State.BuildServer == null, wizard => wizard.BuildServer = _)" IdPrefix="ci" Label="Build server" />
                    break;
                case "have":
                    <ExistingStep State="State" Restored="restored.Existing" Changed="Changed" />
                    break;
                case "tech":
                    <TechStep State="State" Restored="restored.Tech" Changed="Changed" />
                    break;
                case "plugins":
                    <PluginsStep State="State" Changed="Changed" />
                    break;
                case "options":
                    <OptionsStep State="State" Changed="Changed" Advance="() => GoTo(NextStep!.Id)" />
                    break;
                case "sponsor":
                    <SponsorStep State="State" Today="today" Restored="restored.Sponsor" Changed="Changed" />
                    break;
                default:
                    <OutputStep State="State" Today="today" Changed="Changed" />
                    break;
            }

            <div class="wizard-nav">
                @if (PreviousStep is { } previous)
                {
                    <button type="button" class="back" @onclick="() => GoTo(previous.Id)">Back</button>
                }
                else
                {
                    <a class="back" href="">Home</a>
                }

                @if (NextStep is { } next)
                {
                    <button type="button"
                            class="primary"
                            disabled="@(!Current.IsComplete(State, today))"
                            @onclick="() => GoTo(next.Id)">Next: @next.Title</button>
                }
            </div>
        </section>
    </div>
}
