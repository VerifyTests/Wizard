@* The extension picker (plan 7.1 step 7). What the tech stack suggests comes first; everything else
   follows, grouped by category so a long list stays navigable. Every interaction the selection implies
   appears above the cards as soon as the combination exists, rather than at the end. *@
<p class="hint">
    Extensions teach Verify about one kind of value each. Nothing here is required, and anything chosen
    can be deleted from what is generated later. @Extensions.All.Count are available.
</p>

<div class="extension-search">
    <label for="extensionFilter">Filter</label>
    <input type="text"
           id="extensionFilter"
           placeholder="Name or description"
           value="@filter"
           @oninput="FilterChanged" />
    <span class="selected-count">@State.SelectedExtensions.Count selected</span>
</div>

@if (interactions.Count > 0)
{
    <div class="interactions">
        @foreach (var interaction in interactions)
        {
            <InteractionNotice Result="interaction" />
        }
    </div>
}

@if (suggested.Count > 0)
{
    <section class="extension-category suggested">
        <h3>@SuggestedHeading</h3>
        <div class="extension-cards">
            @foreach (var suggestion in suggested)
            {
                <ExtensionCard Definition="Extensions.ById[suggestion.ExtensionId]"
                               Framework="Framework"
                               Selected="State.Has(suggestion.ExtensionId)"
                               Existing="State.IsExisting(suggestion.ExtensionId)"
                               Tag="@Tag(suggestion)"
                               SelectedChanged="_ => Toggle(suggestion.ExtensionId, _)" />
            }
        </div>
    </section>
}

@foreach (var category in Categories)
{
    <section class="extension-category">
        <h3>@category.Key.Label()</h3>
        <div class="extension-cards">
            @foreach (var definition in category)
            {
                <ExtensionCard Definition="definition"
                               Framework="Framework"
                               Selected="State.Has(definition.Id)"
                               Existing="State.IsExisting(definition.Id)"
                               SelectedChanged="_ => Toggle(definition.Id, _)" />
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public WizardState State { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }

    string filter = "";

    IReadOnlyList<InteractionResult> interactions = [];
    IReadOnlyList<Suggestion> suggested = [];

    TestFramework Framework => State.TestFramework ?? TestFramework.XunitV3;

    protected override void OnParametersSet()
    {
        interactions = InteractionRules.For(State);
        suggested = [.. TechSuggestions.For(State).Where(_ => Matches(Extensions.ById[_.ExtensionId]))];
    }

    string SuggestedHeading
    {
        get
        {
            if (State.Techs.Count == 0)
            {
                return "Suggested";
            }

            return "Suggested for this stack";
        }
    }

    static string Tag(Suggestion suggestion)
    {
        var because = string.Join(", ", suggestion.Because);
        if (suggestion.Recommended)
        {
            return $"For {because}";
        }

        return $"Related to {because}";
    }

    // Suggested extensions are listed once, above; the categories hold the rest.
    IEnumerable<IGrouping<ExtensionCategory, ExtensionDefinition>> Categories =>
        Extensions.All
            .Where(_ => Matches(_) && suggested.All(suggestion => suggestion.ExtensionId != _.Id))
            .GroupBy(_ => _.Category)
            .OrderBy(_ => _.Key);

    bool Matches(ExtensionDefinition definition)
    {
        if (filter.Length == 0)
        {
            return true;
        }

        // A selected extension stays visible whatever the filter says, so it cannot be lost from view.
        if (State.Has(definition.Id))
        {
            return true;
        }

        return definition.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase) ||
               definition.Description.Contains(filter, StringComparison.OrdinalIgnoreCase);
    }

    void FilterChanged(ChangeEventArgs args)
    {
        filter = args.Value as string ?? "";
        suggested = [.. TechSuggestions.For(State).Where(_ => Matches(Extensions.ById[_.ExtensionId]))];
    }

    Task Toggle(string id, bool selected)
    {
        State.Select(id, selected);
        return Changed.InvokeAsync();
    }
}
