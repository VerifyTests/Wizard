@* The plugins the project already has (plan 7.2 step 2). Optional. They are never generated, but
   they take part in the interaction rules: adding a plugin next to one of them can change how the
   existing one has to be initialized, and the output says exactly what to edit. *@
<p class="hint">
    Tick the Verify plugins the project already references. They are left out of what is generated,
    and any side effect of adding something next to them is spelled out. The list is remembered in this browser.
</p>

@if (Restored)
{
    <p class="restored">Restored from this browser.</p>
}

@* The file input covers the whole zone, so the browser's own handling of a click and of a drop
   does both jobs, and no script is needed. *@
<div class="packages-drop @(dragging ? "dragging" : "")"
     @ondragenter="() => dragging = true"
     @ondragleave="() => dragging = false"
     @ondrop="() => dragging = false">
    <InputFile @key="inputKey"
               id="packagesProps"
               aria-label="@PackagesProps.FileName"
               accept=".props"
               OnChange="FileChosen" />
    <span>
        <strong>Drop a <code>@PackagesProps.FileName</code> here, or click to browse.</strong>
        The plugins it references are ticked. It is read in this browser and is not uploaded.
    </span>
</div>

@if (result != null)
{
    <p class="packages-result @(result.Failed ? "failed" : "")"><strong>@result.FileName</strong>: @result.Message</p>
}

<div class="plugin-search">
    <label for="existingFilter">Filter</label>
    <input type="text"
           id="existingFilter"
           placeholder="Name"
           value="@filter"
           @oninput="FilterChanged" />
    <span class="selected-count">@State.ExistingPlugins.Count ticked</span>
</div>

@foreach (var category in Categories)
{
    <section class="plugin-category">
        <h3>@category.Key.Label()</h3>
        <div class="existing-list">
            @foreach (var definition in category)
            {
                var existing = State.IsExisting(definition.Id);
                <label class="existing-item @(existing ? "selected" : "")" data-id="@definition.Id">
                    <input type="checkbox"
                           checked="@existing"
                           @onchange="_ => Toggle(definition.Id, (bool?) _.Value ?? false)" />
                    <span>@definition.DisplayName</span>
                </label>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public WizardState State { get; set; } = null!;
    [Parameter] public bool Restored { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    const long maximumFileSize = 1024 * 1024;

    string filter = "";
    bool dragging;
    int inputKey;
    FileResult? result;

    record FileResult(string FileName, string Message, bool Failed = false);

    /// <summary>Adds to what is ticked, never unticks.</summary>
    async Task FileChosen(InputFileChangeEventArgs args)
    {
        dragging = false;
        // a new input, so choosing the same file again raises the change again
        inputKey++;
        result = await Read(args.File);
        await Changed.InvokeAsync();
    }

    async Task<FileResult> Read(IBrowserFile file)
    {
        if (!file.Name.EndsWith(".props", StringComparison.OrdinalIgnoreCase))
        {
            return new(file.Name, $"not a {PackagesProps.FileName}.", true);
        }

        if (file.Size > maximumFileSize)
        {
            return new(file.Name, $"too large to be a {PackagesProps.FileName}.", true);
        }

        using var reader = new StreamReader(file.OpenReadStream(maximumFileSize));
        var xml = await reader.ReadToEndAsync();
        if (!PackagesProps.TryReadPlugins(xml, out var plugins))
        {
            return new(file.Name, "could not be read.", true);
        }

        if (plugins.Count == 0)
        {
            return new(file.Name, "no Verify plugins found.");
        }

        foreach (var id in plugins)
        {
            State.SetExisting(id, true);
        }

        return new(file.Name, $"found {string.Join(", ", plugins.Select(_ => Plugins.ById[_].DisplayName))}.");
    }

    IEnumerable<IGrouping<PluginCategory, PluginDefinition>> Categories =>
        Plugins.All
            .Where(Matches)
            .GroupBy(_ => _.Category)
            .OrderBy(_ => _.Key);

    bool Matches(PluginDefinition definition) =>
        filter.Length == 0 ||
        State.IsExisting(definition.Id) ||
        definition.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase);

    void FilterChanged(ChangeEventArgs args) =>
        filter = args.Value as string ?? "";

    Task Toggle(string id, bool existing)
    {
        State.SetExisting(id, existing);
        return Changed.InvokeAsync();
    }
}
