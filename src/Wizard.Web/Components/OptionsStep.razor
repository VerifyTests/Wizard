@* Per plugin depth, plus every choice the selection raised (plan 7.1 step 8). One compact form:
   each row is a decision that changes the generated code, with the effect spelled out. *@
<p class="hint">
    Verbose generates a commented test for every documented API, so the unwanted ones can be deleted.
    Minimal generates the enable call and the most common usage only.
</p>

<div class="depth-rows">
    @foreach (var plugin in selected)
    {
        <div class="depth-row" data-id="@plugin.Id">
            <span class="depth-name">@plugin.DisplayName</span>
            <span class="depth-toggle">
                @foreach (var depth in depths)
                {
                    var chosen = State.DepthOf(plugin.Id) == depth;
                    <button type="button"
                            class="depth-option @(chosen ? "selected" : "")"
                            aria-pressed="@(chosen ? "true" : "false")"
                            @onclick="() => SetDepth(plugin.Id, depth)">@depth</button>
                }
            </span>
            <span class="depth-count">@Count(plugin, Depth.Verbose) samples at verbose, @Count(plugin, Depth.Minimal) at minimal</span>
        </div>
    }
</div>

@if (choices.Count > 0)
{
    <h3>Choices this combination raised</h3>
    @foreach (var choice in choices)
    {
        <fieldset class="choice" data-choice="@choice.Id">
            <legend>@choice.Label</legend>
            <p class="hint">@choice.Hint</p>
            @foreach (var option in choice.Options)
            {
                var chosen = Value(choice) == option.Value;
                <label class="choice-option @(chosen ? "selected" : "")">
                    <input type="radio"
                           name="@choice.Id"
                           checked="@chosen"
                           @onchange="() => SetChoice(choice.Id, option.Value)" />
                    <span>
                        <strong>@option.Label</strong>
                        @if (option.Hint.Length > 0)
                        {
                            <span class="choice-hint">@option.Hint</span>
                        }
                    </span>
                </label>
            }
        </fieldset>
    }
}

@if (notes.Count > 0)
{
    <h3>What the selection implies</h3>
    <div class="interactions">
        @foreach (var interaction in notes)
        {
            <InteractionNotice Result="interaction" ShowNotes="true" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public WizardState State { get; set; } = null!;
    [Parameter] public EventCallback Changed { get; set; }

    static readonly Depth[] depths = [Depth.Verbose, Depth.Minimal];

    IReadOnlyList<PluginDefinition> selected = [];
    IReadOnlyList<PluginChoice> choices = [];
    IReadOnlyList<InteractionResult> notes = [];

    protected override void OnParametersSet()
    {
        selected = Plugins.Selected(State);
        choices = [.. PlanBuilder.AvailableChoices(State)];
        notes = InteractionRules.For(State);
    }

    static int Count(PluginDefinition definition, Depth depth) =>
        definition.SamplesFor(depth).Count();

    string Value(PluginChoice choice) =>
        State.Choices.GetValueOrDefault(choice.Id, choice.Default);

    Task SetDepth(string id, Depth depth)
    {
        State.SetDepth(id, depth);
        return Changed.InvokeAsync();
    }

    Task SetChoice(string id, string value)
    {
        State.SetChoice(id, value);
        return Changed.InvokeAsync();
    }
}
