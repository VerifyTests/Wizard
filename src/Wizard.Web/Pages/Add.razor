@page "/add"
@page "/add/{PluginId}"

@* Flow B, adding plugins to an existing project (plan 7.2). /add/{PluginId} starts with that
   plugin selected, so each plugin's readme can link straight to it (plan D11). The literal
   /add/by-tech route belongs to flow C and takes precedence over the parameter. *@
<FlowPage Flow="Flow.Add" SeedPlugin="@PluginId" />

@code {
    [Parameter] public string? PluginId { get; set; }
}
