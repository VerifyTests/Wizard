@page "/add"
@page "/add/{ExtensionId}"

@* Flow B, adding extensions to an existing project (plan 7.2). /add/{ExtensionId} starts with that
   extension selected, so each extension's readme can link straight to it (plan D11). The literal
   /add/by-tech route belongs to flow C and takes precedence over the parameter. *@
<FlowPage Flow="Flow.Add" SeedExtension="@ExtensionId" />

@code {
    [Parameter] public string? ExtensionId { get; set; }
}
