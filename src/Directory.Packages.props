<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ProjectDefaults" Version="1.0.191" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="Verify" Version="33.7.3" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.3" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Verify.Bunit" Version="14.1.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageVersion Include="Verify.Playwright" Version="3.3.0" />
    <PackageVersion Include="DiffEngine" Version="21.2.1" />
  </ItemGroup>
</Project>